/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# No Content-Security-Policy is set on purpose.
#
# The site is fully static: no cookies, no sessions, no forms, no user input, no
# server-rendered HTML derived from a request. The pages do carry inline scripts
# (theme resolution before first paint, the mobile nav, the plan chooser), so a
# useful CSP would have to be hash-based and regenerated whenever any inline
# script changes. Shipping a policy with 'unsafe-inline' would look like
# protection while providing none, and shipping a hash-based one without the
# tooling to maintain it would break the site on the next edit. Neither is worth
# it against this threat model; the headers above cover the real risks.

# Astro emits content-hashed filenames under /_assets, so they are safe to pin.
/_assets/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=604800

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
