---
/**
 * Homepage.
 *
 * Order is the conversion argument, not a design preference:
 *
 *   1. What this site is (and that it takes commission) — stated up front,
 *      because a reader who finds out later stops trusting everything above it.
 *   2. The plans most people should look at.
 *   3. The scenario router, for the reader who does not know which plan that is.
 *   4. The decision content (comparisons, guides) and the retention content
 *      (tutorials), which is where a recurring-commission site actually earns.
 *
 * The featured list comes from the `home` singleton so an editor can reorder it
 * without touching this file; the fallback keeps the page intact if that list
 * is emptied.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanCard from '../components/cards/PlanCard.astro';
import TutorialCard from '../components/cards/TutorialCard.astro';
import LinkCard from '../components/cards/LinkCard.astro';
import FaqAccordion from '../components/sections/FaqAccordion.astro';
import AffiliateDisclosure from '../components/sections/AffiliateDisclosure.astro';
import Icon from '../components/ui/Icon.astro';
import {
  DISCLOSURE,
  HOME,
  SITE,
  getActiveDeals,
  getCompares,
  getFeaturedPlans,
  getFaqs,
  getGuides,
  getPosts,
  getScenarios,
  getTutorials,
  plansBySlugs,
  tutorialsBySlugs,
} from '../lib/cms';
import { DEAL_KIND_LABELS, formatDate, GUIDE_INTENT_LABELS } from '../lib/format';
import { itemListSchema } from '../lib/seo';

const featured = (() => {
  const picked = plansBySlugs(HOME.featuredPlans);
  return picked.length > 0 ? picked : getFeaturedPlans();
})();

const scenarios = getScenarios();
const guides = getGuides();
const compares = getCompares();
const deals = getActiveDeals();
const posts = getPosts().slice(0, 3);

const featuredTutorials = (() => {
  const picked = tutorialsBySlugs(HOME.featuredTutorials);
  return picked.length > 0 ? picked : getTutorials().slice(0, 3);
})();

const faqs = getFaqs().slice(0, 5);

const schema = [
  itemListSchema(
    featured.map((plan) => ({ name: plan.name, url: `/plans/${plan.slug}` })),
    '搬瓦工推荐套餐',
  ),
];
---

<BaseLayout
  title={`${SITE.siteName} · ${SITE.tagline}`}
  description={HOME.seo?.description ?? SITE.description}
  keywords={HOME.seo?.keywords}
  schema={schema}
>
  <!-- Hero -->
  <section class="border-b border-line bg-bg-subtle">
    <div class="container-page py-12 sm:py-16">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:items-start">
        <div>
          {HOME.hero.eyebrow && <p class="section-label">{HOME.hero.eyebrow}</p>}
          <h1 class="mt-3 text-3xl font-medium leading-tight sm:text-4xl">
            {HOME.hero.title || SITE.tagline}
          </h1>
          <p class="mt-4 max-w-2xl text-[0.9375rem] leading-relaxed text-fg-muted">
            {HOME.hero.subtitle || SITE.description}
          </p>

          <div class="mt-6 flex flex-wrap items-center gap-2.5">
            <a href="/plans" class="btn btn-primary btn-lg">
              {HOME.hero.primaryCta || '对比全部套餐'}
            </a>
            <a href="/guides/beginner" class="btn btn-secondary btn-lg">
              {HOME.hero.secondaryCta || '我是新手，从哪开始'}
            </a>
            <a href="/tools/chooser" class="btn btn-ghost btn-lg">
              用选择器帮我挑
              <Icon name="arrow" size={14} />
            </a>
          </div>

          <div class="mt-6 max-w-xl">
            <AffiliateDisclosure compact />
          </div>
        </div>

        <!-- Trust points: the four claims the whole site is built to keep. -->
        <ul class="grid gap-2.5 sm:grid-cols-2 lg:grid-cols-1">
          {
            HOME.trustPoints.map((point) => (
              <li class="rounded-lg border border-line bg-surface px-4 py-3">
                <p class="flex items-center gap-1.5 text-sm font-medium">
                  <Icon name="check" size={14} class="text-success" />
                  {point.title}
                </p>
                <p class="mt-1 text-xs leading-relaxed text-fg-muted">{point.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <div class="container-page space-y-14 py-12">
    <!-- Featured plans -->
    <section aria-labelledby="featured-heading" class="space-y-4">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 id="featured-heading" class="text-lg font-medium">大多数人在看的套餐</h2>
          <p class="mt-1 text-sm text-fg-muted">
            按用途挑选过的几个起点，不是按佣金高低排的。每个套餐页都写明「不适合谁」。
          </p>
        </div>
        <a href="/plans" class="btn btn-secondary btn-sm">
          全部套餐
          <Icon name="arrow" size={13} />
        </a>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((plan) => <PlanCard plan={plan} place="home-featured" />)}
      </div>
    </section>

    <!-- Scenario router -->
    <section aria-labelledby="scenario-heading" class="space-y-4">
      <div>
        <h2 id="scenario-heading" class="text-lg font-medium">不确定买哪个？从用途开始</h2>
        <p class="mt-1 text-sm text-fg-muted">
          同一个套餐在不同用途下值不值，结论是不一样的。选一个最接近你的场景。
        </p>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          scenarios.map((scenario) => (
            <a
              href={scenario.guide ? `/guides/${scenario.guide}` : '/tools/chooser'}
              class="card card-hover flex flex-col p-4"
            >
              <h3 class="text-[0.9375rem] font-medium">{scenario.name}</h3>
              <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-fg-muted">{scenario.question}</p>
              {scenario.budgetHint && (
                <p class="mt-3 text-xs text-fg-subtle">常见预算：{scenario.budgetHint}</p>
              )}
            </a>
          ))
        }
      </div>

      <div class="rounded-lg border border-line bg-surface-2 px-4 py-3 text-sm text-fg-muted">
        想更快一点？<a href="/tools/chooser" class="text-brand underline">用三步选择器</a>
        回答三个问题，直接给出两个建议和推荐理由。
      </div>
    </section>

    <!-- Decision content -->
    <section aria-labelledby="decide-heading" class="space-y-4">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 id="decide-heading" class="text-lg font-medium">先把选择想清楚</h2>
          <p class="mt-1 text-sm text-fg-muted">
            线路和机房的差别只在特定场景下体现，这些页面把差别说具体。
          </p>
        </div>
        <a href="/compare" class="btn btn-secondary btn-sm">
          全部对比
          <Icon name="arrow" size={13} />
        </a>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          compares.slice(0, 3).map((compare) => (
            <LinkCard
              href={`/compare/${compare.slug}`}
              title={compare.title}
              summary={compare.verdict}
              eyebrow="对比"
              mono={`${compare.left.label} / ${compare.right.label}`}
            />
          ))
        }
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          guides.map((guide) => (
            <LinkCard
              href={`/guides/${guide.slug}`}
              title={guide.title}
              summary={guide.verdict}
              eyebrow={GUIDE_INTENT_LABELS[guide.intent] ?? guide.intent}
            />
          ))
        }
      </div>
    </section>

    <!-- Deals -->
    {
      deals.length > 0 && (
        <section aria-labelledby="deals-heading" class="space-y-4">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <h2 id="deals-heading" class="text-lg font-medium">当前有效的优惠与政策</h2>
              <p class="mt-1 text-sm text-fg-muted">
                只列人工核实过、且当前有效的条目，并标注核实日期。
              </p>
            </div>
            <a href="/deals" class="btn btn-secondary btn-sm">
              全部优惠
              <Icon name="arrow" size={13} />
            </a>
          </div>

          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {deals.map((deal) => (
              <LinkCard
                href={`/deals/${deal.slug}`}
                title={deal.title}
                summary={deal.summary}
                eyebrow={DEAL_KIND_LABELS[deal.kind] ?? deal.kind}
                mono={deal.code ?? deal.discount}
                meta={[`核实于 ${formatDate(deal.verifiedAt)}`, deal.appliesToRenewal ? '续费可用' : '仅首购']}
              />
            ))}
          </div>
        </section>
      )
    }

    <!-- Retention layer -->
    <section aria-labelledby="learn-heading" class="space-y-4">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 id="learn-heading" class="text-lg font-medium">买了之后怎么用</h2>
          <p class="mt-1 text-sm text-fg-muted">
            教程按步骤写，每步都能单独执行；遇到问题有对应的排查表。
          </p>
        </div>
        <a href="/learn" class="btn btn-secondary btn-sm">
          教程库
          <Icon name="arrow" size={13} />
        </a>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {featuredTutorials.map((tutorial) => <TutorialCard tutorial={tutorial} />)}
      </div>
    </section>

    <!-- FAQ -->
    {
      faqs.length > 0 && (
        <section aria-labelledby="faq-heading" class="space-y-4">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <h2 id="faq-heading" class="text-lg font-medium">
              常见问题
            </h2>
            <a href="/faq" class="btn btn-secondary btn-sm">
              全部问答
              <Icon name="arrow" size={13} />
            </a>
          </div>
          <FaqAccordion items={faqs} headingLevel="h3" />
        </section>
      )
    }

    <!-- Posts -->
    {
      posts.length > 0 && (
        <section aria-labelledby="posts-heading" class="space-y-4">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <h2 id="posts-heading" class="text-lg font-medium">
              站务与说明
            </h2>
            <a href="/blog" class="btn btn-secondary btn-sm">
              全部资讯
              <Icon name="arrow" size={13} />
            </a>
          </div>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <LinkCard
                href={`/blog/${post.slug}`}
                title={post.title}
                summary={post.summary}
                eyebrow="资讯"
                meta={[formatDate(post.publishedAt ?? post.updatedAt)]}
              />
            ))}
          </div>
        </section>
      )
    }

    <!-- Closing statement -->
    <section class="rounded-xl border border-line bg-surface-2 p-5 sm:p-6">
      <h2 class="text-base font-medium">这个站的立场</h2>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-fg-muted">
        {DISCLOSURE.summary}
      </p>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-fg-muted">
        佣金是循环的：用户续费我们继续获得分成。这意味着只有你买到合适的套餐并长期用下去，我们才有收益。
        所以页面里会写「不适合谁」，价格会标注核对日期，实测数据会公开测试方法。
      </p>
      <div class="mt-4 flex flex-wrap gap-2.5">
        <a href="/about" class="btn btn-secondary btn-sm">关于本站与测评方法</a>
        <a href="/disclosure" class="btn btn-secondary btn-sm">完整联盟披露</a>
      </div>
    </section>
  </div>
</BaseLayout>
