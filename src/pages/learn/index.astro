---
/**
 * Tutorial library.
 *
 * Grouped by task category rather than by difficulty, because a reader arrives
 * with a job to do ("reinstall the OS"), not a skill level. Difficulty and time
 * are shown per tutorial so they can pick the five-minute one.
 *
 * This is the retention layer, and it is the part of the site that a
 * recurring-commission model actually pays for: a customer who can operate the
 * server is a customer who renews.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import TutorialCard from '../../components/cards/TutorialCard.astro';
import AffiliateDisclosure from '../../components/sections/AffiliateDisclosure.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { getTutorials, getTutorialsByCategory } from '../../lib/cms';
import { TUTORIAL_CATEGORY_LABELS } from '../../lib/format';
import { breadcrumbSchema, itemListSchema } from '../../lib/seo';

const crumbs = [
  { label: '首页', href: '/' },
  { label: '教程库', href: '/learn' },
];

const tutorials = getTutorials();
const groups = getTutorialsByCategory();

/** Canonical category order — follows the lifecycle, not the alphabet. */
const CATEGORY_ORDER = [
  'purchase',
  'kiwivm',
  'os',
  'network',
  'deploy',
  'security',
  'billing',
  'troubleshoot',
];

const ordered = [...groups].sort(
  (a, b) => CATEGORY_ORDER.indexOf(a.category) - CATEGORY_ORDER.indexOf(b.category),
);

const totalMinutes = tutorials.reduce((sum, tutorial) => sum + tutorial.timeMinutes, 0);

const schema = [
  breadcrumbSchema(crumbs, '/learn'),
  itemListSchema(
    tutorials.map((tutorial) => ({ name: tutorial.title, url: `/learn/${tutorial.slug}` })),
    '搬瓦工教程',
  ),
];
---

<BaseLayout
  title="搬瓦工教程库：面板操作、系统重装与安全加固"
  description="搬瓦工的使用教程，按步骤结构化编写，含常见故障的现象、原因与处理方式。覆盖 KiwiVM 面板、系统重装、机房迁移、SSH 加固与快照备份。"
  keywords={['搬瓦工教程', 'KiwiVM 教程', '搬瓦工重装系统', '搬瓦工迁移机房', 'VPS 教程']}
  schema={schema}
>
  <PageHero
    eyebrow="教程库"
    title="搬瓦工使用教程"
    lede={`共 ${tutorials.length} 篇教程，累计约 ${Math.round(totalMinutes / 60)} 小时的操作量。每篇按步骤写，单步可执行；危险操作会单独标注，并给出把自己锁在门外之后的救援方法。`}
  >
    <Breadcrumbs slot="breadcrumbs" crumbs={crumbs} />
    <Fragment slot="chips">
      <span class="chip chip-mono">{tutorials.length} 篇</span>
      <span class="chip">{ordered.length} 个分类</span>
      <span class="chip">含故障排查表</span>
    </Fragment>
  </PageHero>

  <div class="container-page space-y-12 py-10">
    <AffiliateDisclosure />

    {
      ordered.length > 0 ? (
        <div class="space-y-10">
          {ordered.map((group) => (
            <section aria-labelledby={`cat-${group.category}`} class="space-y-3">
              <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-line pb-2">
                <h2 id={`cat-${group.category}`} class="text-lg font-medium">
                  {TUTORIAL_CATEGORY_LABELS[group.category] ?? group.category}
                </h2>
                <p class="text-xs text-fg-subtle">{group.tutorials.length} 篇</p>
              </div>
              <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                {group.tutorials.map((tutorial) => (
                  <TutorialCard tutorial={tutorial} />
                ))}
              </div>
            </section>
          ))}
        </div>
      ) : (
        <EmptyState
          title="还没有教程内容"
          body="在后台的「教程」集合里添加第一篇教程，页面会自动生成。"
          actionLabel="了解内容结构"
          actionHref="/about"
        />
      )
    }

    <section class="rounded-xl border border-line bg-surface-2 p-5">
      <h2 class="text-base font-medium">教程的写法约定</h2>
      <ul class="mt-3 grid gap-2 text-sm text-fg-muted">
        <li>
          <strong class="font-medium text-fg">步骤可单独执行。</strong>
          每步都写清前置条件，不需要从头读到尾才能用。
        </li>
        <li>
          <strong class="font-medium text-fg">危险操作标注顺序。</strong>
          「先确认密钥登录可用，再关闭密码登录」这类顺序错误会把你自己锁在门外，所以会单独提示。
        </li>
        <li>
          <strong class="font-medium text-fg">给出救援路径。</strong>
          出错之后怎么办，比不出错更重要。面板的 VNC 控制台怎么进，会写在排查表里。
        </li>
      </ul>
      <div class="mt-4 flex flex-wrap gap-2.5">
        <a href="/faq" class="btn btn-secondary btn-sm">看常见问题</a>
        <a href="/plans" class="btn btn-secondary btn-sm">还没买？先看套餐</a>
      </div>
    </section>
  </div>
</BaseLayout>
