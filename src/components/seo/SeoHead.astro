---
/**
 * Per-page `<head>` contents.
 *
 * Everything that varies between pages is a prop; everything that is the same
 * everywhere is read from the `site` singleton, so changing the site name or
 * the default share image is a content edit, not a code edit.
 *
 * Canonical URLs are built from `Astro.url.pathname` rather than passed in, so
 * a page physically cannot emit a canonical pointing somewhere else — the most
 * common way a site accidentally de-indexes itself.
 */
import { SITE } from '../../lib/cms';
import { abs, clampDescription, safeJsonLd } from '../../lib/seo';
import { DEFAULT_OG_IMAGE, SITE_ORIGIN } from '../../config/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Pre-serialised `@graph` payload from `lib/seo`. */
  jsonLd?: string;
  type?: 'website' | 'article';
  publishedAt?: string;
  updatedAt?: string;
  keywords?: string[];
}

const {
  title,
  description = SITE.description,
  ogImage = SITE.defaultOgImage || DEFAULT_OG_IMAGE,
  noindex = false,
  jsonLd = '',
  type = 'website',
  publishedAt,
  updatedAt,
  keywords = [],
} = Astro.props;

const siteName = SITE.siteName;
// Avoid "搬瓦工价格 | 瓦工笔记 | 瓦工笔记" when a page title already names the site.
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

/** `/plans/foo/` and `/plans/foo` must not both exist as canonical. */
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(pathname, SITE_ORIGIN).href;

const desc = clampDescription(description);
const image = /^https?:\/\//i.test(ogImage) ? ogImage : abs(ogImage);
const imageAlt = `${siteName} — ${SITE.tagline}`;
---

<title>{fullTitle}</title>
<meta name="description" content={desc} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(',')} />}
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,follow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={SITE.locale.replace('-', '_')} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:alt" content={imageAlt} />
{publishedAt && <meta property="article:published_time" content={publishedAt} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={image} />

<link rel="alternate" type="application/rss+xml" title={`${siteName} · 资讯`} href={abs('/rss.xml')} />

{jsonLd && <script type="application/ld+json" is:inline set:html={safeJsonLd(jsonLd)} />}
