---
/**
 * Pros and cons, side by side.
 *
 * The cons column is not optional in practice: a recommendation with no
 * downsides reads as an advertisement, and this site's whole pitch is that it
 * will tell you when something is wrong for you. On a recurring commission the
 * downsides are also commercially useful — a buyer who bounces inside the
 * 30-day refund window costs the site the commission *and* the trust.
 */
import Icon from '../ui/Icon.astro';

interface Props {
  pros: string[];
  cons: string[];
  /** Heading overrides, e.g. "适合" / "不适合" on a scenario page. */
  prosTitle?: string;
  consTitle?: string;
}

const { pros, cons, prosTitle = '优点', consTitle = '缺点与限制' } = Astro.props;
---

{
  (pros.length > 0 || cons.length > 0) && (
    <div class="grid gap-4 sm:grid-cols-2">
      {pros.length > 0 && (
        <section class="rounded-lg border border-line bg-surface p-4">
          <h3 class="flex items-center gap-1.5 text-sm font-medium text-success">
            <Icon name="check" size={15} />
            {prosTitle}
          </h3>
          <ul class="mt-3 space-y-2 text-sm text-fg-muted">
            {pros.map((item) => (
              <li class="flex gap-2">
                <span aria-hidden="true" class="mt-[0.6em] h-1 w-1 shrink-0 rounded-full bg-success/70" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {cons.length > 0 && (
        <section class="rounded-lg border border-line bg-surface p-4">
          <h3 class="flex items-center gap-1.5 text-sm font-medium text-signal">
            <Icon name="alert" size={15} />
            {consTitle}
          </h3>
          <ul class="mt-3 space-y-2 text-sm text-fg-muted">
            {cons.map((item) => (
              <li class="flex gap-2">
                <span aria-hidden="true" class="mt-[0.6em] h-1 w-1 shrink-0 rounded-full bg-signal/70" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  )
}
