---
/**
 * Conclusion-first summary block.
 *
 * This is the single most important component for GEO. Answer engines do not
 * synthesise a conclusion from a page of prose — they quote one that has
 * already been written. Every entity page opens with this, and the first
 * sentence has to be the answer, not a preamble.
 *
 * It also does the plain-reader job: someone who reads only this block should
 * still be able to make a decision.
 */
interface Props {
  /** The answer, in one or two sentences. Rendered at body size, not small. */
  verdict?: string;
  /** Scannable supporting points. Three to five; more is the same as none. */
  points?: string[];
  title?: string;
  tone?: 'brand' | 'neutral';
}

const { verdict, points = [], title = '一句话结论', tone = 'brand' } = Astro.props;

const hasContent = Boolean(verdict) || points.length > 0;
---

{
  hasContent && (
    <section
      class:list={[
        'rounded-xl border px-5 py-4',
        tone === 'brand' ? 'border-brand/25 bg-brand-soft/60' : 'border-line bg-surface-2',
      ]}
      aria-label={title}
    >
      <h2 class="section-label">{title}</h2>

      {
        verdict && (
          <p class:list={['mt-2 text-[0.9375rem] leading-relaxed', tone === 'brand' && 'text-fg']}>
            {verdict}
          </p>
        )
      }

      {
        points.length > 0 && (
          <ul class="mt-3 grid gap-1.5 text-sm text-fg-muted">
            {points.map((point) => (
              <li class="flex gap-2">
                <span aria-hidden="true" class="mt-[0.45em] h-1.5 w-1.5 shrink-0 rounded-full bg-brand/60" />
                <span>{point}</span>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  )
}
