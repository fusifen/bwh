---
/**
 * Inline icon set.
 *
 * A dozen hand-written paths instead of an icon library: the public pages ship
 * zero external JavaScript and the whole set weighs less than the loader an
 * icon package would add. Icons are decorative here — every one sits beside a
 * text label — so they are `aria-hidden` unless a `title` is supplied.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  title?: string;
}

const { name, size = 16, class: className = '', title } = Astro.props;

/** 24×24 viewBox, stroke-based, so weight stays consistent across the set. */
const PATHS: Record<string, string> = {
  server:
    'M4 4h16v6H4zM4 14h16v6H4zM7 7h.01M7 17h.01',
  network:
    'M12 3v6M12 15v6M5 12h14M9 9a3 3 0 1 0 6 0 3 3 0 0 0-6 0M3 18a2 2 0 1 0 4 0 2 2 0 0 0-4 0M17 18a2 2 0 1 0 4 0 2 2 0 0 0-4 0',
  book: 'M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2zM4 19V5M8 7h7M8 11h7',
  chart: 'M4 20V10M10 20V4M16 20v-7M22 20H2',
  tag: 'M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0l-7.2-7.2A2 2 0 0 1 3 12V4a1 1 0 0 1 1-1h8a2 2 0 0 1 1.4.6l7.2 7.2a2 2 0 0 1 0 2.6M7 7h.01',
  shield: 'M12 3 5 6v5c0 4.4 2.9 8.4 7 10 4.1-1.6 7-5.6 7-10V6z',
  check: 'm5 13 4 4L19 7',
  x: 'M6 6l12 12M18 6 6 18',
  external: 'M14 4h6v6M20 4l-8 8M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5',
  copy: 'M9 9h10v10H9zM5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1',
  chevron: 'm6 9 6 6 6-6',
  arrow: 'M5 12h14M13 6l6 6-6 6',
  sun: 'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4',
  moon: 'M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5',
  menu: 'M4 7h16M4 12h16M4 17h16',
  search: 'M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16M21 21l-4.3-4.3',
  globe: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18M3 12h18M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18',
  zap: 'M13 2 4 14h7l-1 8 9-12h-7z',
  clock: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18M12 7v5l3 2',
  alert: 'M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0',
  info: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18M12 11v5M12 8h.01',
  seedling:
    'M12 21v-7M12 14c0-4-3-7-7-7 0 4 3 7 7 7M12 14c0-4 3-7 7-7 0 4-3 7-7 7',
  wallet:
    'M3 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM3 8h16M16 13h.01',
