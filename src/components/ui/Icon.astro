};

const d = PATHS[name] ?? PATHS.info;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  data-icon={name}
>
  {title && <title>{title}</title>}
  <path d={d} />
</svg>
