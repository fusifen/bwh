---
/**
 * Site footer.
 *
 * Carries the two things the header deliberately omits: the full content index
 * and the disclosure. The disclosure sits here *and* above the fold on every
 * page that has a purchase link — the footer copy is the one that survives
 * printing and scraping, where the inline block may not.
 */
import { SITE, DISCLOSURE, getActiveDeals, getDatacenters, getLines } from '../../lib/cms';
import { FOOTER_GROUPS } from '../../config/nav';
import { formatDate } from '../../lib/format';
import Icon from '../ui/Icon.astro';

const year = new Date().getUTCFullYear();
const deals = getActiveDeals().slice(0, 3);
const lines = getLines().slice(0, 5);
const datacenters = getDatacenters().slice(0, 5);
---

<footer class="mt-auto border-t border-line bg-bg-subtle">
  <div class="container-page py-12">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.4fr)_repeat(3,minmax(0,1fr))]">
      <div class="max-w-sm">
        <img src={SITE.logo || '/brand/logo.svg'} alt={SITE.siteName} width="132" height="32" class="h-7 w-auto" />
        <p class="mt-3 text-sm text-fg-muted">{SITE.tagline}</p>
        <p class="mt-4 rounded-md border border-line bg-surface px-3 py-2 text-xs leading-relaxed text-fg-muted">
          <Icon name="info" size={13} class="mr-1 inline align-[-2px]" />
          {DISCLOSURE.summary}
          <a href="/disclosure" class="ml-1 text-brand underline">完整披露</a>
        </p>
      </div>

      {
        FOOTER_GROUPS.map((group) => (
          <nav aria-label={group.title}>
            <h2 class="section-label">{group.title}</h2>
            <ul class="mt-3 space-y-1.5 text-sm">
              {group.items.map((item) => (
                <li>
                  <a href={item.href} class="text-fg-muted transition-colors hover:text-brand">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="space-y-6">
        <div>
          <h2 class="section-label">热门线路</h2>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {lines.map((line) => (
              <li>
                <a href={`/lines/${line.slug}`} class="chip hover:border-line-strong">{line.abbr}</a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="section-label">热门机房</h2>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {datacenters.map((dc) => (
              <li>
                <a href={`/datacenters/${dc.slug}`} class="chip hover:border-line-strong">{dc.code}</a>
              </li>
            ))}
          </ul>
        </div>
        {
          deals.length > 0 && (
            <div>
              <h2 class="section-label">进行中的优惠</h2>
              <ul class="mt-3 space-y-1.5 text-sm">
                {deals.map((deal) => (
                  <li>
                    <a href={`/deals/${deal.slug}`} class="text-fg-muted transition-colors hover:text-brand">
                      {deal.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-line pt-6 text-xs text-fg-subtle sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {year} {SITE.publisher?.name || SITE.siteName} · 内容最后复核于 {formatDate(DISCLOSURE.lastReviewedAt)}
      </p>
      <p class="max-w-xl leading-relaxed">
        本站与搬瓦工（BandwagonHost）存在联盟推广关系。页面价格均为税前美元价，可能随时变动，
        下单前请以官方结账页显示的最终金额为准。本站不提供任何规避网络管理的内容。
      </p>
    </div>
  </div>
</footer>
