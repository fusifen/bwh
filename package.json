{
  "name": "stellar-shell",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/generate-llms-txt.mjs",
    "build": "node scripts/build.mjs",
    "build:node": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test:content": "node scripts/test-content.mjs",
    "test:keystatic": "node scripts/test-keystatic.mjs",
    "test:affiliate": "node scripts/test-affiliate.mjs",
    "test:freshness": "node scripts/test-freshness.mjs",
    "test:links": "node scripts/test-links.mjs",
    "audit": "node scripts/audit-build.mjs",
    "audit:dev": "node scripts/audit-build.mjs --allow-placeholder",
    "deploy": "npm run build && wrangler deploy",
    "smoke": "node scripts/smoke-routes.mjs",
    "check:admin": "node scripts/check-admin.mjs",
    "admin:reset": "node scripts/admin-reset.mjs",
    "gen:llms": "node scripts/generate-llms-txt.mjs",
    "verify": "npm run check && npm run test:content && npm run test:keystatic && npm run test:affiliate && npm run test:freshness && npm run test:links && npm run build && npm run audit",
    "verify:dev": "npm run check && npm run test:content && npm run test:keystatic && npm run test:affiliate && npm run test:freshness && npm run test:links && npm run build && npm run audit:dev"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.131.1",
    "zod": "^4.6.2"
  },
  "allowScripts": {
    "esbuild": true
  }
}
