# build output
dist/
# renamed build output — clearing `dist` by renaming it (rather than deleting)
# is common enough that these would otherwise end up committed, and TypeScript
# would then sweep the minified bundles in. See the exclude list in tsconfig.json.
dist-*/
dist.*/

# generated types
.astro/

# dependencies
node_modules/

# Vite dependency pre-bundle — one directory per command, see astro.config.mjs
.vite/
.vite-dev/
.vite-check/

# wrangler / cloudflare local state
.wrangler/

# generated by scripts/generate-llms-txt.mjs at prebuild time
public/llms.txt
public/llms-full.txt

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
build*.log
dev.log

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
